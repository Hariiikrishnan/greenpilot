# Green Pilot — Production Environment Configuration (.env.production.example)
# Place real production configuration in /opt/greenpilot/.env.production (outside git, mode 600)

NODE_ENV=production
PORT=3011

# ── PostgreSQL Database ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://postgres:replace-with-strong-password@postgres:5432/postgres

# ── Redis Cache & BullMQ Broker ───────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Authentication & Cryptography ─────────────────────────────────────────
JWT_SECRET=replace-with-64-char-hex-secret
FORGECRM_ENCRYPTION_KEY=replace-with-64-char-hex-secret

# ── Domains & Routing ─────────────────────────────────────────────────────
CORS_ORIGIN=https://app.greenpilot.in
CORS_ORIGINS=https://app.greenpilot.in,https://greenpilot.in
FRONTEND_URL=https://app.greenpilot.in
API_URL=https://api.greenpilot.in

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────
META_APP_SECRET=replace-with-meta-app-secret
META_API_VERSION=v21.0

# ── Optional Integrations ─────────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
